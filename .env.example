# Root of the backend REST API (today the PMS.API monolith, later the API gateway).
VITE_API_BASE_URL=https://localhost:44391/api

# Serve every service from in-browser mock data (no backend needed).
VITE_USE_MOCK_DATA=false

# Comma-separated services that use mock data even when VITE_USE_MOCK_DATA=false.
# Services: auth, profile, staff, team, parking, capacity, reports
# Every service has a backend endpoint now, so none is mocked by default.
VITE_MOCK_SERVICES=

# Optional: another OAuth 2.0 Web client ID (Google Cloud Console > APIs & Services > Credentials).
# Empty uses the project's client ID (src/lib/google-identity.ts). Must match GoogleAuth:ClientId on the backend.
VITE_GOOGLE_CLIENT_ID=

# Google Maps JavaScript API key for the "Directions to parking lot" map (Google Cloud Console >
# APIs & Services > Credentials). Enable Maps JavaScript API, Routes API and Geocoding API, and
# restrict the key to this site's domains. Empty: the dashboard only links to Google Maps.
VITE_GOOGLE_MAPS_API_KEY=

# Plate reader service for the gate cameras (backend repo: tools/anpr, `uvicorn service:app --port 8001`).
# Empty: http://127.0.0.1:8001 in development, turned off in production builds.
VITE_ANPR_SERVICE_URL=
